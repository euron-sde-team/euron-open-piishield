# Copy to terraform.tfvars (git-ignored) and replace every placeholder.
region      = "us-east-1"
name_prefix = "acme-piishield-prod" # the bucket name derives from this: make it globally unique

hostname        = "piishield.example.com"
certificate_arn = "<ACM_CERTIFICATE_ARN>"    # same region, covering hostname
route53_zone_id = "<ROUTE53_HOSTED_ZONE_ID>" # or remove and CNAME hostname to load_balancer_dns_name

# Alert rule notification mail (SES). New accounts start in the SES sandbox: request
# production access.
mail_domain       = "piishield.example.com"
mail_from_address = "alerts@piishield.example.com"
# mail_from_name  = "Acme PIIShield"

# The image tag pushed to the ecr_repositories output (git commit or release).
# scripts/aws-deploy.sh passes it on the command line instead.
image_tag = "0.1.0"

# alarm_email           = "oncall@example.com"
# metrics_allowed_cidrs = ["203.0.113.10/32"] # your Prometheus egress address

# A self-hosted ClickHouse outside this Terraform (0.1.0 provisions none; empty falls
# back to Postgres trace_rollups_hourly):
# clickhouse_url = "http://clickhouse.internal.example.com:8123"

# Extra non-secret settings (see docs/guides/configuration.md).
# api_extra_environment = { LOGIN_RPM = "20", INGEST_RPM = "600", WORKER_CONCURRENCY = "8" }
