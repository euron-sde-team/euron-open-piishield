# deploy/compose/.env.aws: copy to .env.aws (git-ignored) to run `make up-aws`: the local
# containers (postgres, redis, mailpit, web) stay local, but migrate and api read these
# real AWS resource identifiers and call AWS with your AWS CLI profile (mounted
# read-only; AWS_PROFILE below). Get the values from the aws-dev or aws-prod Terraform
# outputs after `make aws-deploy`, or your own equivalents.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Provisioned by Terraform for a future KMS-backed vault key; 0.1.0's app code does not
# read it yet (KEY_MODE stays local, see compose.aws.yaml's own comment).
KMS_KEY_ID=alias/acme-piishield-dev

# DATABASE_URL and REDIS_URL normally come from Secrets Manager (module.secrets) inside
# ECS; for a local container against real AWS resources, put them here instead (they are
# never committed: this file is git-ignored).
DATABASE_URL=replace-with-terraform-output-connection-url
REDIS_URL=replace-with-terraform-output-connection-url

# Secrets the app otherwise reads from AWS Secrets Manager at runtime (module.secrets).
# LOCAL_MASTER_KEY seals the vault under KEY_MODE=local; 32+ random characters, never a
# default (Settings.guard() refuses to boot with one under ENVIRONMENT=production).
SESSION_SECRET=replace-with-a-real-value
API_KEY_PEPPER=replace-with-a-real-value
LOCAL_MASTER_KEY=replace-with-a-real-value

MAIL_BACKEND=ses
MAIL_FROM_ADDRESS=notifications@piishield-dev.example.com
