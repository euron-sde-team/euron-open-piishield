# deploy/compose/.env: generated by `make env` (scripts/gen-local-env.sh) with random
# values. Local only, git-ignored; this file documents every variable it may hold.

# -- Secrets (random, generated) ----------------------------------------------
# Signs dashboard sessions and CSRF tokens.
SESSION_SECRET=replace-with-output-of-make-env
# Peppers the hashes of project API keys (psk_<prefix>_<secret>).
API_KEY_PEPPER=replace-with-output-of-make-env
# The vault's envelope encryption key when KEY_MODE=local (the Floci overlay uses KMS
# instead): every tokenize call wraps its data key with this before writing a
# vault_entries row.
LOCAL_MASTER_KEY=replace-with-output-of-make-env

# -- Demo ----------------------------------------------------------------------
# The seeded demo logins (make demo); a published demo password, not a secret.
PIISHIELD_DEMO_PASSWORD=Demo-Owner-Pass-1

# -- Optional behaviour ---------------------------------------------------------
# PS_LOG_LEVEL=INFO
# Mail backend under the Floci overlay: smtp (default, Mailpit at http://localhost:5525)
# or ses (the real SES identity Terraform created on the emulator; needs a verified
# recipient per docs/guides/local-with-aws.md, and mail then does not reach Mailpit).
# PS_MAIL_BACKEND=smtp

# -- Host ports (all bound to 127.0.0.1; see docs/PLAN.md "Ports (project 15)") --------
# PS_WEB_PORT=5510
# PS_API_PORT=5530
# PS_PG_PORT=5542
# PS_REDIS_PORT=5579
# PS_FLOCI_PORT=5566
# PS_MAILPIT_PORT=5525
# PS_SMTP_PORT=5526
# PS_MOCK_AI_PORT=5550
